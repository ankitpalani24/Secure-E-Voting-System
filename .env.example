# ==============================================================================
# SECURE ONLINE E-VOTING SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust the variables for your target deployment environment.
# NEVER commit real passwords, MongoDB URLs, or JWT secrets to source control.

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Atlas Replica Set recommended for Production)
# Example Local: mongodb://127.0.0.1:27017/voting-system
# Example Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/voting-system?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/voting-system

# JSON Web Token Secret Key (MUST be at least 32 characters in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_cryptographic_secret_key_minimum_32_bytes!

# Allowed CORS Origin(s) for Production (comma-separated or single domain)
# Example: https://vote.yourdomain.gov
CORS_ORIGIN=*

# Rate Limiting Configuration (Per 15-minute window per IP)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_FACE_MAX=20
RATE_LIMIT_VOTE_MAX=30
