# MongoDB Connection String (Atlas or local replica set)
MONGO_URI=mongodb://127.0.0.1:27017/voting-system

# Server Port
PORT=5000

# JSON Web Token Secret Key (Must be a 64+ char random hex string in production)
JWT_SECRET=replace_with_a_secure_cryptographic_secret_key_minimum_32_bytes!

# Optional Node Environment
NODE_ENV=development
